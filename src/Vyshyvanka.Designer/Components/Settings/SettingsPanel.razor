@namespace Vyshyvanka.Designer.Components

<div class="settings-panel">
    <div class="settings-section">
        <h2 class="section-title">Security</h2>

        @if (_authProvider == "BuiltIn")
        {
            <div class="password-change-form">
                <h3 class="subsection-title">Change Password</h3>

                @if (!string.IsNullOrEmpty(_passwordError))
                {
                    <div class="alert alert--danger">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@_passwordError</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_passwordSuccess))
                {
                    <div class="alert alert--success">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>@_passwordSuccess</span>
                    </div>
                }

                <div class="v-form-group">
                    <label class="v-label" for="current-password">Current Password</label>
                    <input id="current-password"
                           type="password"
                           class="v-input"
                           @bind="_currentPassword"
                           placeholder="Enter current password"
                           disabled="@_isChangingPassword" />
                </div>

                <div class="v-form-group">
                    <label class="v-label" for="new-password">New Password</label>
                    <input id="new-password"
                           type="password"
                           class="v-input"
                           @bind="_newPassword"
                           placeholder="Enter new password"
                           disabled="@_isChangingPassword" />
                </div>

                <div class="v-form-group">
                    <label class="v-label" for="confirm-password">Confirm New Password</label>
                    <input id="confirm-password"
                           type="password"
                           class="v-input"
                           @bind="_confirmPassword"
                           placeholder="Confirm new password"
                           disabled="@_isChangingPassword" />
                </div>

                <button class="v-btn v-btn--primary"
                        @onclick="ChangePasswordAsync"
                        disabled="@(_isChangingPassword || string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))">
                    @if (_isChangingPassword)
                    {
                        <span class="v-spinner v-spinner--sm"></span>
                    }
                    <span>Change Password</span>
                </button>
            </div>
        }
        else
        {
            <p class="settings-note">
                <i class="fa-solid fa-info-circle"></i>
                Password management is handled by your organization's @_authProvider authentication provider.
            </p>
        }
    </div>

    <div class="settings-section">
        <h2 class="section-title">Themes</h2>

        <div class="theme-grid">
            @foreach (var theme in ThemeService.AvailableThemes)
            {
                var isActive = theme.Id == ThemeService.CurrentThemeId;
                <div class="theme-card @(isActive ? "active" : "")" @onclick="() => ApplyTheme(theme.Id)">
                    <div class="theme-card-preview">
                        <span class="preview-swatch" style="background: @theme.Preview.Bg;"></span>
                        <span class="preview-swatch" style="background: @theme.Preview.Accent;"></span>
                        <span class="preview-swatch" style="background: @theme.Preview.Surface;"></span>
                    </div>
                    <div class="theme-card-info">
                        <span class="theme-card-name">@theme.Name</span>
                        <span class="theme-card-mode">@theme.BaseMode</span>
                    </div>
                    <div class="theme-card-actions">
                        @if (isActive)
                        {
                            <i class="fa-solid fa-check active-check"></i>
                        }
                        <button class="btn-icon" title="Export" @onclick:stopPropagation="true" @onclick="() => ExportTheme(theme.Id)">
                            <i class="fa-solid fa-download"></i>
                        </button>
                        @if (!theme.IsBuiltIn)
                        {
                            <button class="btn-icon danger" title="Delete" @onclick:stopPropagation="true" @onclick="() => DeleteTheme(theme.Id)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="theme-upload">
            <label class="upload-area" for="theme-file-input">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span>Upload custom theme JSON</span>
                <InputFile id="theme-file-input" OnChange="OnThemeFileSelected" accept=".json" style="display:none;" />
            </label>
            @if (!string.IsNullOrEmpty(_uploadError))
            {
                <span class="upload-error">@_uploadError</span>
            }
            @if (!string.IsNullOrEmpty(_uploadSuccess))
            {
                <span class="upload-success">@_uploadSuccess</span>
            }
        </div>
    </div>
</div>
